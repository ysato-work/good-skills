{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["agent_total", "groups"],
  "additionalProperties": false,
  "properties": {
    "agent_total": {
      "type": "integer",
      "minimum": 0
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["representative_ref", "agent_refs"],
        "additionalProperties": false,
        "properties": {
          "representative_ref": {
            "type": "string",
            "minLength": 1
          },
          "agent_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "judge_note": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
