{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["confidence", "confidence_plus", "confidence_minus"],
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence_plus": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20
      }
    },
    "confidence_minus": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20
      }
    }
  }
}
